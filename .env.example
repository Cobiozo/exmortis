# Exmortis — przykładowe zmienne środowiskowe (wartości NIE są tu wrzucane).
# Skopiuj ten plik do .env.local i uzupełnij wartościami.

# --- Supabase (kopia danych / logowanie) ---
# Adres projektu Supabase, np. https://xxxxx.supabase.co
VITE_SUPABASE_URL=
# Klucz publiczny (anon) projektu — tylko do odczytów publicznych, nie sekret.
VITE_SUPABASE_ANON_KEY=

# --- Tryb aplikacji ---
# Logowanie: base44 | supabase
VITE_EXM_AUTH_BACKEND=
# Odczyty danych: base44 | supabase
VITE_EXM_ENTITY_BACKEND=

# --- Platforma Base44 (ustawiane przez platformę / build) ---
VITE_BASE44_APP_ID=
VITE_BASE44_APP_BASE_URL=
VITE_BASE44_FUNCTIONS_VERSION=

# Sekrety serwerowe (SUPABASE_SERVICE_KEY, BOOKING_ENC_KEY, BOOKING_HMAC_KEY)
# NIE trzymamy ich w tym pliku na produkcji — są w panelu Base44 > Secrets.
