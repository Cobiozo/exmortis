{
  "name": "ContentLog",
  "type": "object",
  "properties": {
    "page_slug": {
      "type": "string"
    },
    "akcja": {
      "type": "string"
    },
    "opis": {
      "type": "string"
    },
    "wersja": {
      "type": "number"
    },
    "kto": {
      "type": "string"
    }
  },
  "required": [
    "akcja"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "techniczna"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "techniczna"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}