{
  "name": "SilenceSettings",
  "type": "object",
  "properties": {
    "glosnosc_domyslna": {
      "type": "number",
      "default": 60
    },
    "dzwiek_domyslnie": {
      "type": "string",
      "enum": [
        "wlaczony",
        "wyciszony"
      ],
      "default": "wlaczony"
    },
    "wyciszanie_melodii_s": {
      "type": "number",
      "default": 8
    },
    "tekst_wstep": {
      "type": "string",
      "default": "Bez muzyki. Bez powiadomie\u0144. Tylko Ty i czas."
    },
    "tekst_na_koniec": {
      "type": "string",
      "default": "Ta cisza by\u0142a Twoja."
    },
    "muzyka_wlaczona": {
      "type": "boolean",
      "default": false
    },
    "widok_domyslny": {
      "type": "string",
      "enum": [
        "cyfry_pasek",
        "cyfry_sek",
        "cyfry",
        "pasek"
      ],
      "default": "cyfry_pasek"
    }
  },
  "required": [],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "techniczna"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "techniczna"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "techniczna"
          }
        }
      ]
    }
  }
}