{
  "name": "SecurityLog",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "pdf",
        "wideo_limit",
        "blokada",
        "wspoldzielenie",
        "znak_wodny",
        "rabat",
        "drugie_urzadzenie",
        "odstapienie",
        "darmowy",
        "podcast",
        "test",
        "powrot",
        "lista",
        "zapis",
        "listy",
        "webinar",
        "kopia"
      ]
    },
    "user_email": {
      "type": "string"
    },
    "ip": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "until": {
      "type": "string",
      "format": "date-time"
    },
    "resolved": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}