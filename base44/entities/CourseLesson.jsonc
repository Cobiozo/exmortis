{
  "name": "CourseLesson",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "module": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string"
    },
    "media_kind": {
      "type": "string",
      "enum": [
        "wideo",
        "audio"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "default": "wideo",
      "description": "Rodzaj nagrania: wideo albo audio (audio z wgranego pliku, tylko odtwarzanie na koncie)"
    },
    "video_uri": {
      "type": "string"
    },
    "video_name": {
      "type": "string"
    },
    "video_url": {
      "type": "string",
      "description": "Adres wideo spoza aplikacji: w\u0142asny serwer (https, plik mp4/webm, domena z listy w ustawieniach biblioteki), Vimeo, YouTube albo Bunny Stream"
    },
    "duration_min": {
      "type": "number"
    },
    "published": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "product_id",
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}