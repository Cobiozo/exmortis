{
  "name": "CourseLesson",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "module": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string"
    },
    "video_uri": {
      "type": "string"
    },
    "video_name": {
      "type": "string"
    },
    "duration_min": {
      "type": "number"
    },
    "published": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "product_id",
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}