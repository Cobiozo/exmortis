{
  "name": "Utwor",
  "type": "object",
  "properties": {
    "tytul": {
      "type": "string"
    },
    "youtube_url": {
      "type": "string"
    },
    "opis": {
      "type": "string"
    },
    "kolejnosc": {
      "type": "number"
    },
    "widoczny": {
      "type": "boolean",
      "default": true
    },
    "data_dodania": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tytul",
    "youtube_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.widoczny": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}