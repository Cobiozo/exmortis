{
  "name": "RozdrozaStory",
  "type": "object",
  "description": "ROZDRO\u017bA \u2014 historia (szkic + opublikowana kopia). Tylko administrator; klient czyta opublikowan\u0105 kopi\u0119 przez funkcj\u0119 rozdroza.",
  "properties": {
    "slug": {
      "type": "string",
      "description": "Sta\u0142y adres historii (ma\u0142e litery, cyfry, my\u015blniki)"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "description": "Kr\u00f3tki opis do biblioteki"
    },
    "category": {
      "type": "string",
      "enum": [
        "mentalna",
        "duchowa",
        "zyciowa"
      ],
      "description": "\u015amier\u0107 mentalna / duchowa / \u017cyciowa"
    },
    "cover_portrait_url": {
      "type": "string",
      "description": "Ok\u0142adka pionowa 2:3 (biblioteka)"
    },
    "cover_landscape_url": {
      "type": "string",
      "description": "Ok\u0142adka pozioma 16:9 (karta historii)"
    },
    "estimated_minutes": {
      "type": "number",
      "description": "Orientacyjny czas czytania"
    },
    "content_warning": {
      "type": "string",
      "description": "Ostrze\u017cenie o trudnych tre\u015bciach (opcjonalnie)"
    },
    "start_scene_key": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "version": {
      "type": "number",
      "description": "Wersja opublikowanej kopii (ro\u015bnie przy ka\u017cdej publikacji)"
    },
    "published": {
      "type": "object",
      "description": "Opublikowana, sprawdzona kopia historii (to widzi klient). Zmiany scen dzia\u0142aj\u0105 dopiero po ponownej publikacji."
    },
    "published_at": {
      "type": "string"
    },
    "sort_order": {
      "type": "number"
    },
    "draft_changed_at": {
      "type": "string",
      "description": "Ostatnia zmiana szkicu (do oznaczenia \u201ezmiany czekaj\u0105 na publikacj\u0119\u201d)"
    },
    "reading_time": {
      "type": "string",
      "description": "Czas czytania do wy\u015bwietlenia, np. \u201e12\u201316 min\u201d"
    },
    "cover_portrait_prompt": {
      "type": "string",
      "description": "Opis ok\u0142adki 2:3 do generowania (nie jest pokazywany czytelnikom)"
    },
    "cover_landscape_prompt": {
      "type": "string",
      "description": "Opis ok\u0142adki 16:9 do generowania (nie jest pokazywany czytelnikom)"
    },
    "cover_portrait_candidate": {
      "type": "string",
      "description": "Wygenerowana ok\u0142adka 2:3 czekaj\u0105ca na zatwierdzenie"
    },
    "cover_landscape_candidate": {
      "type": "string",
      "description": "Wygenerowana ok\u0142adka 16:9 czekaj\u0105ca na zatwierdzenie"
    },
    "visual_notes": {
      "type": "string",
      "description": "Ci\u0105g\u0142o\u015b\u0107 postaci do prompt\u00f3w graficznych (wiek, wygl\u0105d, str\u00f3j)"
    },
    "image_style": {
      "type": "string",
      "description": "Wsp\u00f3lny styl zdj\u0119\u0107 do prompt\u00f3w graficznych"
    },
    "visual_notes_en": {
      "type": "string",
      "description": "Ci\u0105g\u0142o\u015b\u0107 postaci po angielsku (do prompt\u00f3w)"
    },
    "cover_visual_notes_en": {
      "type": "string",
      "description": "Postacie dozwolone na ok\u0142adkach (po angielsku)"
    },
    "visible_from": {
      "type": "string",
      "description": "Zaplanowana publikacja: od tej chwili (ISO) opublikowana historia jest widoczna dla klient\u00f3w; puste = od razu"
    },
    "reference_image_url": {
      "type": "string",
      "description": "Wz\u00f3r postaci (obraz referencyjny, tylko dostawca OpenAI)"
    }
  },
  "required": [
    "slug",
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}