{
  "name": "RozdrozaStory",
  "type": "object",
  "description": "ROZDROŻA — historia (szkic + opublikowana kopia). Tylko administrator; klient czyta opublikowaną kopię przez funkcję rozdroza.",
  "properties": {
    "slug": {
      "type": "string",
      "description": "Stały adres historii (małe litery, cyfry, myślniki)"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "description": "Krótki opis do biblioteki"
    },
    "category": {
      "type": "string",
      "enum": [
        "mentalna",
        "duchowa",
        "zyciowa"
      ],
      "description": "Śmierć mentalna / duchowa / życiowa"
    },
    "cover_portrait_url": {
      "type": "string",
      "description": "Okładka pionowa 2:3 (biblioteka)"
    },
    "cover_landscape_url": {
      "type": "string",
      "description": "Okładka pozioma 16:9 (karta historii)"
    },
    "estimated_minutes": {
      "type": "number",
      "description": "Orientacyjny czas czytania"
    },
    "content_warning": {
      "type": "string",
      "description": "Ostrzeżenie o trudnych treściach (opcjonalnie)"
    },
    "start_scene_key": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "version": {
      "type": "number",
      "description": "Wersja opublikowanej kopii (rośnie przy każdej publikacji)"
    },
    "published": {
      "type": "object",
      "description": "Opublikowana, sprawdzona kopia historii (to widzi klient). Zmiany scen działają dopiero po ponownej publikacji."
    },
    "published_at": {
      "type": "string"
    },
    "sort_order": {
      "type": "number"
    },
    "draft_changed_at": {
      "type": "string",
      "description": "Ostatnia zmiana szkicu (do oznaczenia „zmiany czekają na publikację”)"
    },
    "reading_time": {
      "type": "string",
      "description": "Czas czytania do wyświetlenia, np. „12–16 min”"
    },
    "cover_portrait_prompt": {
      "type": "string",
      "description": "Opis okładki 2:3 do generowania (nie jest pokazywany czytelnikom)"
    },
    "cover_landscape_prompt": {
      "type": "string",
      "description": "Opis okładki 16:9 do generowania (nie jest pokazywany czytelnikom)"
    },
    "cover_portrait_candidate": {
      "type": "string",
      "description": "Wygenerowana okładka 2:3 czekająca na zatwierdzenie"
    },
    "cover_landscape_candidate": {
      "type": "string",
      "description": "Wygenerowana okładka 16:9 czekająca na zatwierdzenie"
    },
    "visual_notes": {
      "type": "string",
      "description": "Ciągłość postaci do promptów graficznych (wiek, wygląd, strój)"
    },
    "image_style": {
      "type": "string",
      "description": "Wspólny styl zdjęć do promptów graficznych"
    }
  },
  "required": [
    "slug",
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}