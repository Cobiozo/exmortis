{
  "name": "DiscountCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "procent",
        "kwota"
      ],
      "default": "procent"
    },
    "value": {
      "type": "number"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "max_uses": {
      "type": "number"
    },
    "uses": {
      "type": "number",
      "default": 0
    },
    "product_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "w_powiadomieniach": {
      "type": "boolean",
      "default": false,
      "description": "Pokaż kod zalogowanym klientom w powiadomieniach (dzwoneczek)"
    },
    "opis": {
      "type": "string",
      "description": "Krótki opis dla klienta, np. 'Na start Skarbca'"
    },
    "gift_to": {
      "type": "string",
      "description": "Karta podarunkowa: imię obdarowanego"
    },
    "gift_message": {
      "type": "string",
      "description": "Karta podarunkowa: słowa od darczyńcy"
    },
    "gift_token": {
      "type": "string",
      "description": "Karta podarunkowa: klucz linku do wydruku"
    },
    "buyer_email": {
      "type": "string",
      "description": "Karta podarunkowa: e-mail kupującego"
    }
  },
  "required": [
    "code",
    "kind",
    "value"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}