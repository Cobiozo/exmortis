{
  "name": "PageRedirect",
  "type": "object",
  "properties": {
    "from_slug": {
      "type": "string"
    },
    "to_slug": {
      "type": "string"
    }
  },
  "required": [
    "from_slug",
    "to_slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "techniczna"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "techniczna"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "techniczna"
          }
        }
      ]
    }
  }
}