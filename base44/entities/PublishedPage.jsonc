{
  "name": "PublishedPage",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "tytul": {
      "type": "string"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "string"
    },
    "seo_image": {
      "type": "string"
    },
    "noindex": {
      "type": "boolean",
      "default": false
    },
    "bloki": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "wersja": {
      "type": "number"
    }
  },
  "required": [
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "techniczna"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "techniczna"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "techniczna"
          }
        }
      ]
    }
  }
}