{
  "name": "MediaAsset",
  "type": "object",
  "properties": {
    "pub_id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "oryginal_uri": {
      "type": "string"
    },
    "warianty": {
      "type": "object"
    },
    "nazwa": {
      "type": "string"
    },
    "alt": {
      "type": "string"
    },
    "szer": {
      "type": "number"
    },
    "wys": {
      "type": "number"
    },
    "rozmiar_kb": {
      "type": "number"
    },
    "znak_wodny": {
      "type": "boolean",
      "default": false
    },
    "usuniety_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "pub_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "techniczna"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "techniczna"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "techniczna"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "techniczna"
          }
        }
      ]
    }
  }
}