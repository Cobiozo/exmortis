{
  "name": "MediaAsset",
  "type": "object",
  "properties": {
    "pub_id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "oryginal_uri": {
      "type": "string"
    },
    "warianty": {
      "type": "object"
    },
    "nazwa": {
      "type": "string"
    },
    "alt": {
      "type": "string"
    },
    "szer": {
      "type": "number"
    },
    "wys": {
      "type": "number"
    },
    "rozmiar_kb": {
      "type": "number"
    },
    "znak_wodny": {
      "type": "boolean",
      "default": false
    },
    "usuniety_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "pub_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}