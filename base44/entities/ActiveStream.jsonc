{
  "name": "ActiveStream",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "lesson_id": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "session_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}