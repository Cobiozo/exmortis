{
  "name": "ObokUczestnik",
  "type": "object",
  "properties": {
    "seria_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "imie": {
      "type": "string"
    },
    "joined_at": {
      "type": "string",
      "format": "date-time"
    },
    "powiadomienia": {
      "type": "boolean",
      "default": false
    },
    "zrodlo": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "wyslane": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "seria_id",
    "user_email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}