{
  "name": "SiteNav",
  "type": "object",
  "properties": {
    "menu": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    },
    "test": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      }
    },
    "kolumny": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "szkic": {
      "type": "object"
    },
    "zmiany_niezapisane": {
      "type": "boolean",
      "default": false
    },
    "wersja": {
      "type": "number",
      "default": 0
    },
    "opublikowano_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
