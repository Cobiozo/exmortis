{
  "name": "RozdrozaScene",
  "type": "object",
  "description": "ROZDROŻA — scena (szkic). Tylko administrator.",
  "properties": {
    "story_id": {
      "type": "string"
    },
    "scene_key": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "scene_type": {
      "type": "string",
      "enum": [
        "narrative",
        "decision",
        "ending"
      ]
    },
    "image_url": {
      "type": "string"
    },
    "alt_text": {
      "type": "string"
    },
    "next_scene_key": {
      "type": "string"
    },
    "reflection_question": {
      "type": "string"
    },
    "sort_order": {
      "type": "number"
    },
    "image_prompt": {
      "type": "string",
      "description": "Opis kadru (KADR) do generowania — nie jest pokazywany czytelnikom"
    },
    "image_candidate_url": {
      "type": "string",
      "description": "Wygenerowany kadr czekający na zatwierdzenie (nie zastępuje zatwierdzonego obrazu bez akceptacji)"
    }
  },
  "required": [
    "story_id",
    "scene_key",
    "scene_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}