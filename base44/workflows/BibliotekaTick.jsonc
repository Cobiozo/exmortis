{
  "name": "Biblioteka \u2014 wysy\u0142ka i higiena danych",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Europe/Warsaw",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Co 5 minut: wysy\u0142a wiadomo\u015bci zaplanowane na teraz (atomowe przej\u0119cie, najwy\u017cej 20 na godzin\u0119), wysy\u0142a zbiorcze powiadomienia o nowych materia\u0142ach i czy\u015bci histori\u0119 zmian starsz\u0105 ni\u017c 12 miesi\u0119cy. Wywo\u0142anie potwierdza si\u0119 tokenem tick_token z mb_settings \u2014 bez niego libraryTick zwraca 403. Token musi by\u0107 wpisany w tym pliku, bo workflow Base44 nie potrafi odczyta\u0107 sekret\u00f3w ani warto\u015bci z bazy.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "biblioteka_tick",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "tick": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "libraryTick",
            "args": {
              "tick_token": "I5U8h24BrfhYd_Ty_NsdM2QGUsDflwmWRH0h4uh38NA"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Zadanie biblioteki",
            "description": "Wysy\u0142ka, powiadomienia, historia"
          }
        }
      }
    ]
  }
}