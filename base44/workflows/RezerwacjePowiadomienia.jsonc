{
  "name": "Rezerwacje 1:1 \u2014 przypomnienia",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "Europe/Warsaw",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "WY\u0141\u0104CZONY \u2014 praca przeniesiona do \u201eZadania cykliczne\u201d (o pe\u0142nych kwadransach). Co 15 minut wysy\u0142a przypomnienia 24 h i 1 h przed spotkaniem. Liczone s\u0105 od aktualnego terminu: po przeniesieniu stare wpisy s\u0105 anulowane, a sp\u00f3\u017anione (powy\u017cej 20 minut) nie wychodz\u0105 wcale. Wywo\u0142anie potwierdza si\u0119 tokenem tick_token z bk_settings \u2014 bez niego bookingPublic zwraca 403.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "rezerwacje_powiadomienia",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "przypomnienia": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "bookingPublic",
            "args": {
              "action": "notify_tick"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Przypomnienia o spotkaniach",
            "description": "24 h i 1 h przed terminem"
          }
        }
      }
    ]
  }
}