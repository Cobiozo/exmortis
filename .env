# --- Tryb aplikacji ---
# Odczyty danych z kopii Supabase (powrót na bazę aplikacji: zmień na base44 albo usuń).
VITE_EXM_ENTITY_BACKEND=supabase
# Logowanie: supabase (konta w Supabase Auth).
VITE_EXM_AUTH_BACKEND=supabase
# Funkcje serwerowe (zapisy, panele, checkout, zadania): supabase = Edge Functions. Bez tego strona woła starego Base44.
VITE_EXM_FN_BACKEND=supabase

# Adres aplikacji do nagłówków dla robotów przy budowaniu — ten sam co app_url w panelu.
VITE_APP_URL=https://exmortis.pl
